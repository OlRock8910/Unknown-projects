            <path android:fillColor="#FFDCD0FF"
                android:pathData="M64,26 V34 a4,4 0 0 0 4,4 H76 Z" />
            <!-- ruled lines -->
            <path android:strokeColor="#FFD4CBF2" android:strokeWidth="2.2" android:strokeLineCap="round"
                android:pathData="M39,46 H69 M39,54 H69 M39,62 H69 M39,70 H58" />
