            <path android:fillColor="#FFFF8FB1" android:pathData="M61.5,47 a3,3 0 0 1 3,-3 h3 a3,3 0 0 1 3,3 V48.5 H61.5 Z" />
            <path android:fillColor="#FFC9CAD6" android:pathData="M61.5,48.5 H70.5 V52 H61.5 Z" />
            <path android:fillColor="#FFFFC53D" android:pathData="M61.5,52 H70.5 V74 H61.5 Z" />
            <path android:fillColor="#FFF0A92B" android:pathData="M66,52 H70.5 V74 H66 Z" />
            <path android:fillColor="#FFF6DDB4" android:pathData="M61.5,74 H70.5 L66,84 Z" />
            <path android:fillColor="#FF3A2E5C" android:pathData="M64.2,80 H67.8 L66,84 Z" />
