<?xml version="1.0" encoding="utf-8"?>
<!-- A lined note sheet with a folded corner, and a pencil writing on it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
    <!-- Kept inside the circle that round-icon launchers cut out. -->
    <group android:scaleX="0.88" android:scaleY="0.88" android:pivotX="54" android:pivotY="54">
        <group android:rotation="-7" android:pivotX="54" android:pivotY="54">
