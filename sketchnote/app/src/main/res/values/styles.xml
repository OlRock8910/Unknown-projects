<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sketchnote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
        <item name="android:popupMenuStyle">@style/Popup</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <style name="Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_2</item>
    </style>

    <style name="Popup" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_bg</item>
    </style>
</resources>
