<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions at all: boards stay in the app's own storage, pictures come in through the
         system picker, and exports go out through the share sheet or MediaStore. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Sketchnote"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sketchnote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BoardActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|density"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".ImageEditActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|density" />

        <provider
            android:name=".ExportProvider"
            android:authorities="com.infinink.app.exports"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
