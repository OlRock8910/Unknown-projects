<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0B0D10</color>
    <color name="accent">#FF5A1F</color>
    <color name="rec_red">#FF3B30</color>
    <color name="text_primary">#F5F7FA</color>
    <color name="text_secondary">#A3ACB9</color>
    <color name="text_dim">#6B7480</color>
    <color name="divider">#1FFFFFFF</color>
    <color name="track_off">#3A414D</color>

    <style name="Theme.GymCam" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Text.Caps" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Sub" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="GlassSwitch" parent="">
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
    </style>

    <style name="GlassSeek" parent="">
        <item name="android:progressTint">@color/accent</item>
        <item name="android:progressBackgroundTint">@color/track_off</item>
        <item name="android:thumbTint">@color/text_primary</item>
        <item name="android:splitTrack">false</item>
    </style>

    <style name="GlassCircleButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_glass_circle</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_primary</item>
    </style>
</resources>
