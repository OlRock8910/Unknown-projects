<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="40dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:text="GymCam"
            android:textColor="@color/text_primary"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Film your sets. Your music keeps playing."
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <TextView
            style="@style/Text.Caps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Tap each one to allow it" />

        <include
            android:id="@+id/permCamera"
            layout="@layout/row_permission" />

        <include
            android:id="@+id/permMic"
            layout="@layout/row_permission" />

        <include
            android:id="@+id/permPhotos"
            layout="@layout/row_permission" />

        <include
            android:id="@+id/permNotif"
            layout="@layout/row_permission" />

        <TextView
            style="@style/Text.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hint"
            android:lineSpacingExtra="2dp"
            android:padding="14dp"
            android:text="Later, when you turn on &quot;Song in video&quot;, Android will ask to record your screen. That's the only way to grab your song. GymCam keeps the song only: never the screen, never your voice." />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_accent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Allow access"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
