<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lingo Peak"
        android:textColor="#2F5BEA"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="This week"
        android:textColor="#6B6F80"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_mins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 / 20 min"
        android:textColor="#1B1D2A"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/w_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="6dp"
        android:max="20"
        android:progress="0"
        android:progressDrawable="@drawable/widget_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 week streak"
            android:textColor="#FF5A4E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_words"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 words"
            android:textColor="#1B1D2A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
