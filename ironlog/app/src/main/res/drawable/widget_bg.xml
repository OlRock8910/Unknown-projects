<?xml version="1.0" encoding="utf-8"?>
<!-- Tinted black glass: dark translucent fill, a lime glow in one corner, a soft top sheen and a light rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:startColor="#F0182312"
                android:centerColor="#F0070A08"
                android:endColor="#F0071419" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="radial"
                android:centerX="0.1"
                android:centerY="0.0"
                android:gradientRadius="220dp"
                android:startColor="#38B8FF2C"
                android:endColor="#00B8FF2C" />
        </shape>
    </item>
    <item android:bottom="60dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
            <gradient android:angle="270" android:startColor="#1AFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
        </shape>
    </item>
</layer-list>
