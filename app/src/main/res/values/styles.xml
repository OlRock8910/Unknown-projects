<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark Material with no action bar; every colour on screen is drawn by the app itself. -->
    <style name="Theme.Strobe" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">#FF21E6FF</item>
    </style>
</resources>
